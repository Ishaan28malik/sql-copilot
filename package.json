{
  "name": "sql-copilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sqlcopilot/web dev",
    "dev:api": "pnpm --filter @sqlcopilot/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sqlcopilot/database db:generate",
    "db:migrate": "pnpm --filter @sqlcopilot/database db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
